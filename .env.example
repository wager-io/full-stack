# The frontend is a static SPA; the ENTIRE backend is Supabase
# (Postgres + Auth + Realtime + Edge Functions). There is no Node/Express server.
#
# Local dev: run `supabase start` and use the values it prints.
# Production: use your Supabase project's URL + anon (publishable) key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-or-project-anon-key
