# The frontend is a static SPA; the ENTIRE backend is Supabase
# (Postgres + Auth + Realtime + Edge Functions). There is no Node/Express server.
#
# Local dev: run `supabase start` and use the values it prints.
# Production: use your Supabase project's URL + anon (publishable) key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-or-project-anon-key

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY. Never give this a VITE_ prefix: Vite inlines every VITE_*
# variable into the JavaScript bundle served to every visitor, and this key
# bypasses Row Level Security entirely.
#
# Used only by `npm run promote-admin` and local Edge Function development.
# Local:  the `service_role key` printed by `supabase start`
# Hosted: Project Settings -> API -> service_role (secret)
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# CCPayment — deposits, withdrawals, webhooks (Phase 5).
#
# SERVER-SIDE ONLY. No VITE_ prefix, for the same reason as the service role
# key above: the App Secret signs every API request, so a copy in the bundle
# is a copy anyone can use to move funds. Edge Functions read these; src/
# never does.
#
# Credentials: https://console.ccpayment.com/developer/config
# The App Secret is displayed ONCE, at creation. Copy it before closing.
#
# Do NOT put these in .env.production -- that file feeds the client build.
# Deployed, they belong in Edge Function secrets:
#   supabase secrets set CCPAYMENT_APP_ID=... CCPAYMENT_APP_SECRET=...
#
# IP WHITELIST. CCPayment only answers requests from whitelisted IPs (else
# error 224076). Supabase Edge Functions are globally distributed and have no
# static egress IP, so a deployed function CANNOT be whitelisted as-is:
#   https://supabase.com/docs/guides/troubleshooting/why-supabase-edge-functions-cannot-provide-static-egress-ips-for-whitelisting-3d78b0
# Either route CCPayment calls through a proxy with a fixed IP and whitelist
# that, or host the payments layer somewhere with static outbound IPs. For
# local work, whitelist your own public IP (`curl ifconfig.me`), or tick
# "Developer Test Mode" in the console, which lifts the IP restriction.
# ---------------------------------------------------------------------------
CCPAYMENT_APP_ID=
CCPAYMENT_APP_SECRET=
CCPAYMENT_API_BASE=https://ccpayment.com/ccpayment/v2

# CCPayment's webhook sender. Inbound only -- nothing to do with the whitelist
# above; relevant only if a firewall sits in front of the webhook function.
CCPAYMENT_WEBHOOK_SOURCE_IP=54.150.123.157

# Static-IP outbound proxy for CCPayment calls. Unset = direct, which works
# locally (whitelist your own IP, or tick Developer Test Mode) and fails in
# production with code 224076. The old Node backend used QuotaGuard for exactly
# this (QUOTAGUARDSTATIC_URL in services/ccpayment.services.js).
CCPAYMENT_PROXY_URL=
