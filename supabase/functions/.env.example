# Secrets for the Edge Functions. Copy to `supabase/functions/.env` (NOT committed)
# and pass it when serving locally:
#
#   supabase functions serve --env-file supabase/functions/.env
#
# Hosted, the same values are set once with:
#
#   supabase secrets set CCPAYMENT_APP_ID=... CCPAYMENT_APP_SECRET=...
#
# NOT listed here, and not needed here: SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY. The Edge Runtime injects all three automatically,
# both locally and on a hosted project. Setting them by hand is how you end up
# with a function pointing at the wrong project.

# CCPayment v2 credentials (Dashboard -> Developers -> API).
# Used for: deposit addresses, the coin list, price lookups, submitting
# withdrawals, and verifying the HMAC on every inbound webhook.
CCPAYMENT_APP_ID=
CCPAYMENT_APP_SECRET=

# Override only if CCPayment moves the API. Defaults to the v2 endpoint.
# Either name is read; CCPAYMENT_API_BASE_URL wins if both are set. The hosted
# project uses CCPAYMENT_API_BASE, which is why both are supported.
# CCPAYMENT_API_BASE_URL=https://ccpayment.com/ccpayment/v2
# CCPAYMENT_API_BASE=https://ccpayment.com/ccpayment/v2
